
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Worked Example — Motivational Interviewing</title>
<style>
  :root{
    --bg:#ffffff; --panel:#f7f6f4; --ink:#1f1e1c; --muted:#6f6c66;
    --line:#e7e4de; --line2:#eceae4;
    --clinician-bubble:#efe7e0; --patient-bubble:#eceae7;
    --amber-bg:#fffbef; --amber-line:#e7c98a; --amber-ink:#8a6d2f;
    --accent:#8a5a25; --accent-ink:#6f4a20;
    --instr-bg:#eef3fb; --instr-line:#c9d9f0; --instr-ink:#2f4a72;
    --tab-active:#8a5a25;
    --chip-bg:#e9e7e2; --chip-ink:#4a4740;
    --field:#ffffff; --focus:#2f6f4f;
    --ok-bg:#eef5ee; --ok-line:#bcd6bd; --ok-ink:#3c5c3e;
    --radius:16px; --r-sm:11px;
  }
  *{box-sizing:border-box;}
  body{margin:0;background:var(--bg);color:var(--ink);
    font-family:ui-sans-serif,-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    line-height:1.5;-webkit-font-smoothing:antialiased;}
  .wrap{max-width:940px;margin:0 auto;padding:22px 18px 60px;}

  /* Stage tabs */
  .stagebar{display:flex;align-items:center;gap:12px;margin-bottom:18px;flex-wrap:wrap;}
  .stage-tab{display:flex;align-items:center;gap:10px;border:1px solid var(--line);
    background:#fff;color:var(--ink);border-radius:10px;padding:10px 16px;cursor:pointer;
    font-size:14.5px;transition:.15s;}
  .stage-tab .n{color:var(--muted);}
  .stage-tab[aria-selected="true"]{background:var(--tab-active);border-color:var(--tab-active);color:#fff;}
  .stage-tab[aria-selected="true"] .n{color:#f0dcc6;}
  .stage-tab:focus-visible{outline:2px solid var(--focus);outline-offset:2px;}
  .arrow{color:var(--muted);}
  .progress{display:flex;gap:5px;margin-left:auto;align-items:center;}
  .pdot{width:26px;height:6px;border-radius:3px;background:var(--line);}
  .pdot.on{background:var(--accent);}

  /* Card shell */
  .panel{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);
    padding:24px 24px 26px;}
  h2.sess{margin:0 0 6px;font-size:22px;letter-spacing:-.01em;}
  .sess-blurb{margin:0 0 14px;color:var(--muted);font-size:15px;max-width:70ch;}
  .metarow{display:flex;flex-wrap:wrap;gap:9px;align-items:center;margin-bottom:8px;}
  .pchip{background:#fff;border:1px solid var(--line);border-radius:8px;padding:5px 11px;font-size:13px;}
  .pchip b{font-weight:600;}
  .scen{background:var(--chip-bg);color:var(--chip-ink);border-radius:8px;padding:5px 11px;font-size:13px;}
  .recafter{display:flex;gap:6px;align-items:center;color:var(--muted);font-size:13.5px;margin:6px 0 2px;}
  .recafter a{color:var(--accent);text-decoration:none;cursor:default;}

  /* Instruction box */
  .instr{background:var(--instr-bg);border:1px solid var(--instr-line);color:var(--instr-ink);
    border-radius:12px;padding:14px 16px;margin:16px 0 20px;font-size:14px;line-height:1.55;}
  .instr h3{margin:0 0 6px;font-size:14px;font-weight:700;}
  .instr b{font-weight:700;}
  .instr .done{font-weight:700;}

  /* Chat */
  .chat{display:flex;flex-direction:column;gap:16px;}
  .row{display:flex;gap:12px;}
  .row.cl{flex-direction:row-reverse;}
  .avatar{flex:0 0 auto;width:34px;height:34px;border-radius:50%;background:#efe7df;
    display:grid;place-items:center;margin-top:20px;}
  .row.pt .avatar{background:#e9e9e6;}
  .stack{max-width:74%;display:flex;flex-direction:column;gap:8px;}
  .who{font-size:12.5px;color:var(--muted);}
  .row.cl .who{text-align:right;}
  .bubble{border-radius:14px;padding:13px 15px;font-size:15px;line-height:1.5;}
  .row.cl .bubble{background:var(--clinician-bubble);border-top-right-radius:5px;text-align:right;}
  .row.pt .bubble{background:var(--patient-bubble);border-top-left-radius:5px;}
  .tech{background:var(--amber-bg);border:1px solid var(--amber-line);border-radius:10px;
    padding:10px 13px;font-size:13px;color:var(--amber-ink);line-height:1.5;text-align:left;}
  .tech b{color:var(--amber-ink);font-weight:700;}

  /* Toggle */
  .toggle{margin-top:24px;border-top:1px solid var(--line);padding-top:18px;}
  .toggle h4{margin:0 0 4px;font-size:15px;}
  .toggle p{margin:0 0 12px;color:var(--muted);font-size:13.5px;max-width:74ch;}
  .toggle-btns{display:flex;flex-wrap:wrap;gap:9px;}
  .tbtn{border:1px solid var(--line);background:#fff;border-radius:9px;padding:9px 15px;
    cursor:pointer;font-size:13.5px;color:var(--ink);transition:.15s;}
  .tbtn[aria-pressed="true"]{background:var(--accent);border-color:var(--accent);color:#fff;}
  .tbtn:focus-visible{outline:2px solid var(--focus);outline-offset:2px;}

  /* Stage 2 gaps */
  .gapwrap{display:flex;flex-direction:column;gap:8px;}
  .gap-ta{width:100%;min-height:82px;resize:vertical;border:1px solid var(--line);
    border-radius:12px;padding:12px 14px;font:inherit;font-size:15px;background:var(--field);
    border-top-right-radius:5px;}
  .gap-ta:focus{outline:none;border-color:var(--focus);}
  .gap-ta.locked{background:#f3f1ec;color:#55524c;}
  .submit{align-self:flex-end;background:var(--accent);color:#fff;border:none;border-radius:10px;
    padding:10px 18px;font-size:14px;cursor:pointer;}
  .submit:disabled{opacity:.5;cursor:default;}
  .submit:focus-visible{outline:2px solid var(--focus);outline-offset:2px;}

  .compare{display:flex;flex-direction:column;gap:10px;margin-top:2px;}
  .cmp-card{border-radius:12px;padding:12px 14px;font-size:14px;line-height:1.55;text-align:left;}
  .cmp-expert{background:var(--clinician-bubble);}
  .cmp-expert .lab{font-size:11.5px;text-transform:uppercase;letter-spacing:.06em;color:var(--accent-ink);font-weight:700;margin-bottom:4px;}
  .cmp-tech{background:var(--amber-bg);border:1px solid var(--amber-line);color:var(--amber-ink);}
  .cmp-tech b{font-weight:700;}
  .cmp-fb{background:var(--ok-bg);border:1px solid var(--ok-line);color:var(--ok-ink);}
  .cmp-fb .lab{font-size:11.5px;text-transform:uppercase;letter-spacing:.06em;font-weight:700;margin-bottom:5px;}
  .cmp-fb p{margin:0 0 7px;}
  .cmp-fb .k{font-weight:700;}

  .status{font-size:13px;color:var(--muted);margin-top:14px;}
  .status b{color:var(--accent-ink);}
  .hidden{display:none !important;}
  .done-banner{margin-top:16px;background:var(--ok-bg);border:1px solid var(--ok-line);
    color:var(--ok-ink);border-radius:12px;padding:14px 16px;font-size:14.5px;}
  .done-banner b{font-weight:700;}

  .bottom-nav{margin-top:22px;padding-top:18px;border-top:1px solid var(--line);
    display:flex;justify-content:flex-end;}
  .bottom-nav.back{justify-content:flex-start;}
  .nav-btn{display:inline-flex;align-items:center;gap:9px;border:none;cursor:pointer;
    background:var(--accent);color:#fff;border-radius:10px;padding:12px 20px;font-size:15px;
    font-weight:600;transition:.15s;}
  .nav-btn.secondary{background:#fff;color:var(--ink);border:1px solid var(--line);font-weight:500;}
  .nav-btn:hover{filter:brightness(1.05);}
  .nav-btn:focus-visible{outline:2px solid var(--focus);outline-offset:2px;}

  @media(max-width:560px){
    .stack{max-width:86%;}
    .panel{padding:18px 15px 20px;}
    h2.sess{font-size:19px;}
  }
  @media (prefers-reduced-motion:reduce){ *{transition:none !important;} }
</style>
</head>
<body>
<div class="wrap">

  <div class="stagebar">
    <button class="stage-tab" id="tab1" aria-selected="true" onclick="setStage(1)">
      <svg width="17" height="17" viewBox="0 0 20 20" fill="none"><path d="M2 10s3-5.5 8-5.5S18 10 18 10s-3 5.5-8 5.5S2 10 2 10Z" stroke="currentColor" stroke-width="1.5"/><circle cx="10" cy="10" r="2.3" stroke="currentColor" stroke-width="1.5"/></svg>
      <span><span class="n">Stage 1:</span> Learn from the Expert</span>
    </button>
    <span class="arrow">&rarr;</span>
    <button class="stage-tab" id="tab2" aria-selected="false" onclick="setStage(2)">
      <svg width="16" height="16" viewBox="0 0 20 20" fill="none"><path d="M4 14.5 13.5 5l2 2L6 16.5 3.5 17l.5-2.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
      <span><span class="n">Stage 2:</span> Fill in the Gaps</span>
    </button>
    <span class="progress" id="progress" aria-hidden="true"><span class="pdot on"></span><span class="pdot" id="pdot2"></span></span>
  </div>

  <div class="panel">
    <h2 class="sess" id="sessTitle"></h2>
    <p class="sess-blurb" id="sessBlurb"></p>
    <div class="metarow">
      <span class="pchip" id="pchip"></span>
      <span class="scen" id="scen"></span>
    </div>
    <div class="recafter" id="recafter"></div>

    <div class="instr" id="instr"></div>

    <div class="chat" id="chat"></div>

    <!-- Stage 1 patient toggle -->
    <div class="toggle hidden" id="toggle">
      <h4>Explore with a different patient</h4>
      <p>Same clinical situation, different patient. Every score, technique, and recommendation stays identical &mdash; only communication style adapts. Consider what you would change before clicking.</p>
      <div class="toggle-btns" id="toggleBtns"></div>
    </div>

    <div class="done-banner hidden" id="doneBanner"></div>
    <div class="status hidden" id="status"></div>

    <div class="bottom-nav hidden" id="bottomNav"></div>
  </div>
</div>

<script>
// ===========================================================================
// Worked Example data — Motivational Interviewing (Ambivalence About Alcohol Use)
// Base transcript + technique annotations taken verbatim from the instructor mockup.
// Patient-variant dialogue keeps clinical reasoning and technique constant;
// only communication style (register / vocabulary / framing) adapts.
// Stage 2 feedback grounded in MI/OARS evidence base (Miller & Rollnick; SAMHSA TIP 35).
// ===========================================================================

// Turn types: "clinician" (fixed, shown with technique), "patient",
// and in Stage 2 some clinician turns become "gap" (student writes, then compares).
// technique{} carries the amber-annotation text and the short label used in feedback.

const SESSION = {
  title: "Exploring Ambivalence About Alcohol Use",
  tag: "MI & Readiness",
  blurb: "A skilled MI session with a college student who is ambivalent about reducing alcohol use. Demonstrates OARS techniques and change-talk evocation.",
  recommendedAfter: ["Readiness Assessment", "Facilitating Readiness"],

  // Which clinician turns become gaps in Stage 2 (0-based index into clinician turns).
  // Chosen to sample one of each major skill family across the session.
  gapClinicianIndices: [2, 3, 4, 5],

  patients: {
    college: {
      label: "Alex, 21",
      chip: "Binge drinking on weekends, referred by residence advisor after an incident",
      // register note shown to nobody; documents the adaptation rationale
      note: "Baseline college-student register."
    },
    adolescent: {
      label: "Jordan, 15",
      chip: "Drinking at weekend gatherings, referred by school counselor after a health-class disclosure",
      note: "Adolescent (14-16): shorter sentences, concrete framing, autonomy emphasized, parents/school as salient context, less abstract 'grad school' framing replaced with near-term goals."
    },
    literacy: {
      label: "Sam, 24",
      chip: "Heavy weekend drinking, referred by a clinic nurse after an ER visit",
      note: "Limited literacy: plain words, one idea per sentence, no jargon, concrete examples, avoids abstract nouns; techniques identical."
    },
    older: {
      label: "Mr. Ellis, 72",
      chip: "Increased evening drinking since retirement, flagged by primary-care provider at an annual visit",
      note: "Older adult (70+): respectful register, life-stage context (retirement, health, family/grandchildren), unhurried pacing; techniques identical."
    }
  },

  // Each entry: role, and for clinician turns a `technique` {label, text}.
  // Patient/clinician `text` is keyed by patient variant.
  turns: [
    { role: "clinician",
      technique: { label: "Open question",
        text: "Open question: Invites the patient to share their perspective, respecting autonomy rather than leading with the referral reason." },
      text: {
        college:    "Thanks for coming in today, Alex. I'd like to understand what's been going on from your perspective. What brought you here?",
        adolescent: "Thanks for coming in today, Jordan. I'd like to hear how things look from where you sit. What's going on that led to you coming in?",
        literacy:   "Thanks for coming in today, Sam. I want to hear it from you. What's been happening?",
        older:      "Thank you for coming in today, Mr. Ellis. I'd like to understand things from your point of view. What brings you in?"
      }
    },
    { role: "patient",
      text: {
        college:    "Honestly, my RA made me come after I got sick at a dorm party last weekend. I don't really think it's a big deal. Everyone drinks in college.",
        adolescent: "The counselor made me come. I said something in health class and now everyone's freaking out. It's not a big deal, everybody at the parties drinks.",
        literacy:   "The nurse told me to come. I had to go to the ER last weekend. I don't think it's a big deal. Everybody drinks on the weekend.",
        older:      "My doctor suggested it. Since I retired I've been having a few more in the evenings. I don't see it as a real problem. A drink at night never hurt anyone."
      }
    },
    { role: "clinician",
      technique: { label: "Simple reflection",
        text: "Simple reflection: Accurately mirrors the patient's perspective without judgment, building rapport and demonstrating understanding." },
      text: {
        college:    "So from where you stand, what happened feels pretty normal for college life, and being here wasn't exactly your idea.",
        adolescent: "So from where you stand, this feels pretty normal for people your age, and coming in wasn't your idea.",
        literacy:   "So to you, this feels normal. And coming here wasn't your choice.",
        older:      "So from where you stand, an evening drink feels ordinary, and coming in today wasn't really your idea."
      }
    },
    { role: "patient",
      text: {
        college:    "Yeah, exactly. I mean, I know I overdid it that one night, but it's not like I drink every day or anything.",
        adolescent: "Yeah. I mean, I know that one night was too much, but I don't drink all the time.",
        literacy:   "Yeah. That one night was too much, I know. But I don't drink every day.",
        older:      "That's right. I may have had one too many some nights, but it's not as if I'm drinking all day long."
      }
    },
    // clinician index 3 -> GAP in Stage 2
    { role: "clinician",
      technique: { label: "Complex reflection + Open question",
        text: "Complex reflection + Open question: Reflects the implied concern (\"overdid it\") to highlight the patient's own words, then follows with an open question to explore the pattern without assuming." },
      text: {
        college:    "You can see that particular night went further than you intended. I'm curious — what does a typical weekend look like for you when it comes to drinking?",
        adolescent: "You can tell that one night went further than you meant it to. I'm curious — what does a usual weekend look like for you with drinking?",
        literacy:   "You can see that night went too far. Can you tell me — what's a normal weekend like for you with drinking?",
        older:      "You recognize that some nights go further than you intend. I'm curious — what does a typical evening look like for you when it comes to drinking?"
      }
    },
    { role: "patient",
      text: {
        college:    "I usually go out Friday and Saturday. I'll have maybe five or six drinks each night. Sometimes more if there's a big party. It's just how we socialize.",
        adolescent: "It's mostly Fridays when people hang out. Maybe four or five, more if it's a big one. That's just what everyone does to hang out.",
        literacy:   "Friday and Saturday I go out. Maybe five or six drinks. More if it's a big night. That's just how we have fun.",
        older:      "Most evenings now I'll have three or four. More on a Friday, perhaps. It's how I unwind since I stopped working."
      }
    },
    // clinician index 5 -> GAP in Stage 2
    { role: "clinician",
      technique: { label: "Complex reflection targeting meaning",
        text: "Complex reflection targeting meaning: Goes beyond the surface content to reflect the underlying function of drinking — social connection and belonging." },
      text: {
        college:    "Drinking is really woven into your social life right now. It's how you connect with your friends and feel part of things.",
        adolescent: "Drinking is tied to hanging out with your friends. It's part of feeling like you belong.",
        literacy:   "Drinking is a big part of being with your friends. It helps you feel like you fit in.",
        older:      "Drinking has become part of how you fill the evenings and feel at ease now that the workdays are behind you."
      }
    },
    { role: "patient",
      text: {
        college:    "Right. But I guess... my grades did slip last semester. I missed a few Monday morning classes because I was hungover. My parents would be disappointed if they knew.",
        adolescent: "Yeah. But... I did miss practice a couple times. And I felt awful at school the next day. My mom would be really upset if she found out.",
        literacy:   "Right. But my work did suffer. I missed a couple shifts because I felt so bad the next day. My family would be upset.",
        older:      "True. Though I have noticed I'm more tired, and my balance isn't what it was. My daughter worries. I'd hate for her to fret over me."
      }
    },
    // clinician index 7 -> GAP in Stage 2
    { role: "clinician",
      technique: { label: "Double-sided reflection",
        text: "Double-sided reflection: Captures both sides of the ambivalence without pushing toward either. This develops discrepancy by letting the patient hear their own conflicting values side by side." },
      text: {
        college:    "On one hand, drinking is an important part of how you connect socially. On the other hand, you're noticing it's starting to affect your academics and you care about what your parents would think. That's a real tension.",
        adolescent: "On one hand, drinking is part of hanging out with your friends. On the other, you're noticing it's affecting school and practice, and you care what your mom thinks. That's a real pull in two directions.",
        literacy:   "On one side, drinking helps you feel part of things. On the other side, it's hurting your work and worrying your family. Those two things pull against each other.",
        older:      "On one hand, an evening drink helps you unwind. On the other, you're noticing it affects your energy and balance, and you care about not worrying your daughter. That's a real tension."
      }
    },
    { role: "patient",
      text: {
        college:    "Yeah, I guess it is. I don't want to be the person who flunks out because of partying. I actually want to go to grad school eventually.",
        adolescent: "Yeah, I guess so. I don't want to mess up school. I actually want to make the team next year and maybe get a scholarship someday.",
        literacy:   "Yeah, it is. I don't want to lose my job over this. I want to keep things going okay.",
        older:      "I suppose it is. I don't want to end up unwell or a burden. I'd like to stay independent and enjoy my time with the grandchildren."
      }
    },
    // clinician index 9 -> GAP in Stage 2
    { role: "clinician",
      technique: { label: "Affirmation + Reflection of change talk",
        text: "Affirmation + Reflection of change talk: Affirms the patient's values and aspirations (not the person, but their stated goals), then reflects the emerging change talk about the discrepancy between behavior and values." },
      text: {
        college:    "You have real aspirations for your future. Going to grad school matters to you, and you can see how the current pattern might get in the way of that.",
        adolescent: "You've got real goals. Making the team and keeping your future open matter to you, and you can see how the current pattern might get in the way.",
        literacy:   "You care about your future. Keeping your job matters to you, and you can see how drinking might get in the way of that.",
        older:      "You have things you value deeply — your independence and time with your grandchildren. And you can see how the current pattern might get in the way of that."
      }
    },
    { role: "patient",
      text: {
        college:    "It does matter. I just don't know what I'd do on weekends if I wasn't drinking with everyone. It feels like I'd be left out.",
        adolescent: "It does matter. But I don't know what I'd do at parties if I wasn't drinking. I'd feel left out.",
        literacy:   "It does matter. But I don't know what I'd do on weekends without it. I'd feel left out.",
        older:      "It does matter. But I'm not sure what I'd do of an evening without it. The house is very quiet these days."
      }
    },
    { role: "clinician",
      technique: { label: "Reflection of sustain talk + Evoking question",
        text: "Reflection of sustain talk + Evoking question: Validates the legitimate concern, then poses an evocative question that invites the patient to envision a different possibility without prescribing a solution." },
      text: {
        college:    "The idea of changing feels risky because you might lose something important — the connection and belonging. What would it look like if you could keep those friendships but drink less?",
        adolescent: "Changing feels risky because you might lose something that matters — feeling part of the group. What would it look like if you could still hang out with everyone but drink less?",
        literacy:   "Changing feels risky. You might lose something that matters — feeling part of things. What would it look like to still be with your friends but drink less?",
        older:      "Changing feels risky because you might lose something that matters — a bit of comfort in the evenings. What might it look like to keep that ease but drink less?"
      }
    },
    { role: "patient",
      text: {
        college:    "I mean, some of my friends don't drink as much and they still come out. I guess I could try having fewer drinks and still hang out. I just never really thought about it that way.",
        adolescent: "I guess some people don't drink much and still come to stuff. Maybe I could have less and still hang out. I never really thought about it like that.",
        literacy:   "Some of my friends don't drink much and still come out. Maybe I could have less and still go. I never thought about it that way.",
        older:      "Some evenings I don't drink much at all and I'm fine. I suppose I could have one instead of three and still feel settled. I hadn't thought of it that way."
      }
    },
    { role: "clinician",
      technique: { label: "Collecting summary + Open question",
        text: "Summary + Open question: Provides a collecting summary that weaves together the key elements of the conversation — the initial stance, the emerging ambivalence, the values, and the patient's own ideas. Ends with an open question that invites the patient to state their own next step." },
      text: {
        college:    "So you already have evidence from your own friend group that it's possible to be social without drinking as much. That's something you noticed on your own. Let me see if I have this right: you came in today not sure this was a problem, and now you're recognizing that while drinking connects you socially, it's also pulling against your academic goals and the future you want. You've even started thinking about what a middle path might look like. Where does that leave you?",
        adolescent: "So you already know people who don't drink much and still come out — you noticed that yourself. Let me check I've got this right: you came in not sure this was a problem, and now you're seeing that while drinking helps you fit in, it's also getting in the way of school and your goals. You've even started thinking about a middle path. Where does that leave you?",
        literacy:   "So you already know people who drink less and still have fun — you saw that yourself. Let me make sure I've got this right. You came in not sure this was a problem. Now you see that drinking helps you fit in, but it also hurts your work and worries your family. And you've started thinking about a middle way. Where does that leave you?",
        older:      "So you've noticed yourself that some evenings you drink little and feel perfectly fine. Let me see if I have this right: you came in unsure this was a problem, and now you're recognizing that while a drink brings some comfort, it's also affecting your health and worrying your daughter. You've even begun considering a middle path. Where does that leave you?"
      }
    },
    { role: "patient",
      text: {
        college:    "I think I want to try cutting back. Maybe set a limit for myself for weekends. I'm not ready to stop completely, but I could try three drinks max and see how it goes.",
        adolescent: "I think I want to try cutting back. Maybe set a limit for myself. I'm not going to stop completely, but I could try two max and see how it goes.",
        literacy:   "I think I want to cut back. Maybe set a limit. I'm not going to stop for good, but I could try three drinks and see how it goes.",
        older:      "I think I'd like to cut back. Perhaps set myself a limit in the evenings. I'm not ready to give it up entirely, but I could try one instead of three and see how I feel."
      }
    },
    { role: "clinician",
      technique: { label: "Affirmation + Confidence ruler",
        text: "Affirmation + Confidence ruler: Affirms the patient's effort and agency, then uses the confidence ruler to assess self-efficacy and potentially evoke more change talk about their ability to follow through." },
      text: {
        college:    "You've come up with a concrete plan that feels realistic to you. That took some real thought and honesty today. How confident are you, on a scale from 0 to 10, that you could stick with a three-drink limit this weekend?",
        adolescent: "You've come up with a plan that feels realistic to you. That took real thought and honesty today. On a scale from 0 to 10, how confident are you that you could stick with a two-drink limit this weekend?",
        literacy:   "You made a plan that feels real to you. That took honesty today. On a scale from 0 to 10, how sure are you that you can stick to three drinks this weekend?",
        older:      "You've arrived at a plan that feels realistic to you. That took real thought and honesty today. On a scale from 0 to 10, how confident are you that you could keep to one drink this evening?"
      }
    }
  ]
};

// Per-gap coaching feedback (grounded in MI/OARS). Keyed by clinician-turn index.
// "look_for" = what a strong student response would contain; "why" = MI rationale.
const GAP_FEEDBACK = {
  // position 2 — Complex reflection + Open question
  2: {
    lookFor: "A reflection that returns the patient's own words (the night going 'further than intended') followed by an open question about the typical pattern.",
    why: "Leading with a reflection before the question keeps the patient in the driver's seat and lowers defensiveness; an open (not yes/no) question invites the patient to describe the pattern in their own words, which surfaces more than an interrogation would.",
    watchFor: "Avoid closed questions ('Do you drink a lot?') or advice this early — both tend to evoke sustain talk and discord."
  },
  // position 3 — Complex reflection targeting meaning
  3: {
    lookFor: "A complex reflection that names the underlying function of drinking (belonging, connection, unwinding), not just the surface facts.",
    why: "Reflecting meaning rather than content signals deep listening and often prompts the patient to voice the other side of their ambivalence on their own.",
    watchFor: "A simple restatement of the numbers ('So you have five or six drinks') is accurate but shallower; push toward what the drinking does for the patient."
  },
  // position 4 — Double-sided reflection
  4: {
    lookFor: "A double-sided reflection holding both the value of drinking and the emerging cost, joined by 'and' or 'on the other hand' — not 'but'.",
    why: "Holding both sides without resolving them develops discrepancy: the patient hears their own conflicting values side by side and is drawn to resolve the tension toward change. 'But' would subtly side against the drinking and can provoke defense.",
    watchFor: "Don't collapse to one side or add your own argument for change; let the tension sit."
  },
  // position 5 — Affirmation + Reflection of change talk
  5: {
    lookFor: "An affirmation of the patient's values or effort (not flattery of the person) followed by a reflection of the change talk they just voiced.",
    why: "Affirming agency supports self-efficacy, and reflecting change talk reinforces it, making the patient more likely to elaborate on their own reasons for change.",
    watchFor: "Affirm the stated goal or effort, not 'you're a good person'; and reflect their words rather than praising them for agreeing with you."
  }
};


// ---- state ----
var stage = 1;
var patientKey = "college";
var submitted = {}; // gapIndex -> true

var PATIENT_ORDER = ["adolescent","literacy","older"];
var PATIENT_BTNLABEL = {adolescent:"Adolescent (14-16)", literacy:"Limited literacy", older:"Older adult (70+)"};

function el(tag, cls, html){ var e=document.createElement(tag); if(cls)e.className=cls; if(html!=null)e.innerHTML=html; return e; }
function esc(s){ return (s||"").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;"); }

function clinicianTurnIndices(){
  var out=[]; SESSION.turns.forEach(function(t,i){ if(t.role==="clinician") out.push(i); }); return out;
}
function isGap(turnIdx){
  var cl = clinicianTurnIndices();
  var pos = cl.indexOf(turnIdx);
  return stage===2 && SESSION.gapClinicianIndices.indexOf(pos)!==-1;
}
function clinicianPos(turnIdx){ return clinicianTurnIndices().indexOf(turnIdx); }

function renderHeader(){
  document.getElementById("sessTitle").textContent = SESSION.title;
  document.getElementById("sessBlurb").textContent = SESSION.blurb;
  var p = SESSION.patients[patientKey];
  document.getElementById("pchip").innerHTML = "<b>Patient:</b> " + esc(p.label);
  document.getElementById("scen").textContent = p.chip;
  var ra = document.getElementById("recafter");
  ra.innerHTML = "";
  var book = '<svg width="16" height="16" viewBox="0 0 20 20" fill="none" style="flex:0 0 auto"><path d="M3 4.5h5.5c.8 0 1.5.7 1.5 1.5v9c0-.8-.7-1.5-1.5-1.5H3v-9Z" stroke="#6f6c66" stroke-width="1.3"/><path d="M17 4.5h-5.5c-.8 0-1.5.7-1.5 1.5v9c0-.8.7-1.5 1.5-1.5H17v-9Z" stroke="#6f6c66" stroke-width="1.3"/></svg>';
  ra.insertAdjacentHTML("beforeend", book + "<span>Recommended after:</span>");
  SESSION.recommendedAfter.forEach(function(r,i){
    ra.insertAdjacentHTML("beforeend", (i?" , ":" ") + '<a>'+esc(r)+'</a>');
  });
}

function renderInstr(){
  var box = document.getElementById("instr");
  if(stage===1){
    box.innerHTML =
      "<h3>What to do in Stage 1</h3>" +
      "(1) Read the full conversation from top to bottom. " +
      "(2) After each clinician response, read the <b>amber annotation box</b> below it. It explains <i>why</i> the clinician said what they said, not just the technique name. " +
      "(3) When a response surprises you, write one sentence about what you expected and why the expert's choice differs. " +
      "When you have read every exchange and every annotation, select <b>Stage 2: Fill in the Gaps</b>.";
  } else {
    box.innerHTML =
      "<h3>What to do in Stage 2</h3>" +
      "(1) Read the conversation to the first gap. (2) Type what you think the clinician could say. " +
      "(3) Select <b>Submit Response</b> to reveal the expert response and feedback. (4) Read the feedback before moving to the next gap. " +
      "<div class='done'>You are done when every gap has a submitted response and you have read each comparison.</div>";
  }
}

function bubbleRow(turn, turnIdx){
  var role = turn.role;
  var row = el("div","row "+(role==="clinician"?"cl":"pt"));
  var av = el("div","avatar");
  av.innerHTML = role==="clinician"
    ? '<svg width="18" height="18" viewBox="0 0 20 20" fill="none"><path d="M6 3v4a3 3 0 0 0 6 0V3" stroke="#8a5a25" stroke-width="1.4" stroke-linecap="round"/><path d="M9 10v2a4 4 0 0 0 8 0v-1" stroke="#8a5a25" stroke-width="1.4"/><circle cx="17" cy="9.5" r="1.6" stroke="#8a5a25" stroke-width="1.4"/></svg>'
    : '<svg width="18" height="18" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="7" r="3" stroke="#6f6c66" stroke-width="1.4"/><path d="M4 16c0-3 2.7-5 6-5s6 2 6 5" stroke="#6f6c66" stroke-width="1.4" stroke-linecap="round"/></svg>';
  var stack = el("div","stack");
  var who = el("div","who", role==="clinician" ? (isGap(turnIdx) ? "Clinician (Your Turn)" : "Clinician") : "Patient");
  stack.appendChild(who);

  if(isGap(turnIdx)){
    stack.appendChild(buildGap(turn, turnIdx));
  } else {
    var b = el("div","bubble", esc(turn.text[patientKey]));
    stack.appendChild(b);
    if(role==="clinician" && turn.technique){
      var tech = el("div","tech","<b>Technique:</b> " + esc(turn.technique.text));
      stack.appendChild(tech);
    }
  }
  row.appendChild(av); row.appendChild(stack);
  return row;
}

function buildGap(turn, turnIdx){
  var wrap = el("div","gapwrap");
  var done = submitted[turnIdx];
  var ta = el("textarea","gap-ta"+(done?" locked":""));
  ta.placeholder = "What would you say to the patient here?";
  ta.setAttribute("aria-label","Your clinician response for this gap");
  if(done){ ta.value = done.text; ta.readOnly = true; }
  wrap.appendChild(ta);

  if(!done){
    var btn = el("button","submit","Submit Response");
    btn.disabled = true;
    ta.addEventListener("input", function(){ btn.disabled = ta.value.trim().length===0; });
    btn.addEventListener("click", function(){
      submitted[turnIdx] = { text: ta.value.trim() };
      renderChat(); updateStatus();
    });
    wrap.appendChild(btn);
  } else {
    wrap.appendChild(buildCompare(turn, turnIdx));
  }
  return wrap;
}

function buildCompare(turn, turnIdx){
  var pos = clinicianPos(turnIdx);
  var fb = GAP_FEEDBACK[pos];
  var box = el("div","compare");
  var exp = el("div","cmp-card cmp-expert");
  exp.innerHTML = "<div class='lab'>Expert Response</div>" + esc(turn.text[patientKey]);
  box.appendChild(exp);
  var tech = el("div","cmp-card cmp-tech","<b>Technique:</b> " + esc(turn.technique.text));
  box.appendChild(tech);
  var f = el("div","cmp-card cmp-fb");
  f.innerHTML = "<div class='lab'>Feedback</div>" +
    "<p><span class='k'>What a strong response includes:</span> " + esc(fb.lookFor) + "</p>" +
    "<p><span class='k'>Why:</span> " + esc(fb.why) + "</p>" +
    "<p><span class='k'>Watch for:</span> " + esc(fb.watchFor) + "</p>";
  box.appendChild(f);
  return box;
}

function renderChat(){
  var chat = document.getElementById("chat");
  chat.innerHTML = "";
  SESSION.turns.forEach(function(t,i){ chat.appendChild(bubbleRow(t,i)); });
}

function updateStatus(){
  var status = document.getElementById("status");
  var banner = document.getElementById("doneBanner");
  if(stage!==2){ status.classList.add("hidden"); banner.classList.add("hidden"); return; }
  var total = SESSION.gapClinicianIndices.length;
  var gapTurnIdxs = clinicianTurnIndices().filter(function(ti){ return isGap(ti); });
  var done = gapTurnIdxs.filter(function(ti){ return submitted[ti]; }).length;
  status.classList.remove("hidden");
  status.innerHTML = "Gaps completed: <b>"+done+" of "+total+"</b>.";
  if(done===total){
    banner.classList.remove("hidden");
    banner.innerHTML = "<b>Stage 2 complete.</b> You've submitted every gap and can compare each of your responses with the expert's. You've now finished both stages of this worked example.";
  } else {
    banner.classList.add("hidden");
  }
}

function renderToggle(){
  var t = document.getElementById("toggle");
  if(stage!==1){ t.classList.add("hidden"); return; }
  t.classList.remove("hidden");
  var box = document.getElementById("toggleBtns");
  box.innerHTML = "";
  // include a way back to baseline
  var all = [["college","Alex, 21 (baseline)"]].concat(PATIENT_ORDER.map(function(k){return [k,PATIENT_BTNLABEL[k]];}));
  all.forEach(function(pair){
    var b = el("button","tbtn", pair[1]);
    b.setAttribute("aria-pressed", String(patientKey===pair[0]));
    b.addEventListener("click", function(){
      patientKey = pair[0];
      renderHeader(); renderChat(); renderToggle();
    });
    box.appendChild(b);
  });
}

function renderBottomNav(){
  var nav = document.getElementById("bottomNav");
  nav.innerHTML = "";
  nav.classList.remove("hidden","back");
  if(stage===1){
    var b = el("button","nav-btn");
    b.innerHTML = 'Next Stage: Fill in the Gaps ' +
      '<svg width="15" height="15" viewBox="0 0 20 20" fill="none"><path d="M4 10h11M11 6l4 4-4 4" stroke="#fff" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>';
    b.addEventListener("click", function(){ setStage(2); });
    nav.appendChild(b);
  } else {
    nav.classList.add("back");
    var b2 = el("button","nav-btn secondary");
    b2.innerHTML = '<svg width="15" height="15" viewBox="0 0 20 20" fill="none"><path d="M16 10H5M9 6l-4 4 4 4" stroke="#1f1e1c" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg> Back to Stage 1';
    b2.addEventListener("click", function(){ setStage(1); });
    nav.appendChild(b2);
  }
}

function setStage(s){
  stage = s;
  document.getElementById("tab1").setAttribute("aria-selected", String(s===1));
  document.getElementById("tab2").setAttribute("aria-selected", String(s===2));
  document.getElementById("pdot2").classList.toggle("on", s===2);
  // Stage 2 always uses baseline patient (variants are a Stage-1-only feature)
  if(s===2){ patientKey = "college"; }
  renderHeader(); renderInstr(); renderChat(); renderToggle(); updateStatus(); renderBottomNav();
  window.scrollTo({top:0, behavior:"smooth"});
}

// init
renderHeader(); renderInstr(); renderChat(); renderToggle(); updateStatus(); renderBottomNav();
</script>
</body>
